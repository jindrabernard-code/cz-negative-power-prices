# Copy to .env and fill in. .env is git-ignored.

# ENTSO-E Transparency Platform (required)
# Register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# with the subject "Restful API access". After approval:
# My Account Settings -> Web API Security Token -> Generate.
ENTSOE_API_KEY=

# Copernicus Climate Data Store (optional, only for the era5_* panel columns)
# https://cds.climate.copernicus.eu/profile -> Personal Access Token.
# Accept the ERA5 single-levels licence on the dataset page first.
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
